pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Preparing Python application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                dir('ex9/python-flask-app') {
                    sh 'python3 -m pip install --break-system-packages -r requirements.txt'
                    sh 'python3 -m unittest discover -s . -p "test_*.py"'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${WORKSPACE}/python-app-deploy"
                    cp "${WORKSPACE}/ex9/python-flask-app/app.py" "${WORKSPACE}/python-app-deploy/"
                    cp "${WORKSPACE}/ex9/python-flask-app/requirements.txt" "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting application...'
                sh '''
                    cd "${WORKSPACE}/python-app-deploy"
                    python3 -m pip install --break-system-packages -r requirements.txt
                    nohup python3 app.py > app.log 2>&1 &
                    echo $! > app.pid
                    sleep 3
                    if ! kill -0 "$(cat app.pid)" 2>/dev/null; then
                        cat app.log
                        exit 1
                    fi
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application...'
                sh '''
                    python3 - <<'PYTEST'
import urllib.request
response = urllib.request.urlopen("http://127.0.0.1:5000/", timeout=10)
body = response.read().decode()
print("HTTP status:", response.status)
print("Response:", body)
assert response.status == 200
assert "Hello, Jenkins Multi-Stage Pipeline!" in body
print("Deployed application test passed.")
PYTEST
                '''
            }
        }
    }

    post {
        always {
            sh '''
                if [ -f "${WORKSPACE}/python-app-deploy/app.pid" ]; then
                    kill "$(cat "${WORKSPACE}/python-app-deploy/app.pid")" 2>/dev/null || true
                fi
            '''
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
